POSTGRES_PASSWORD=change-me
DOMAIN=localhost
# ALLOWED_ORIGINS — JSON-массив, напр. ["http://localhost:5173"]

# LLM-слой: автокатегоризация операций и разбор произвольных выписок.
# Без ключа обе возможности молча ничего не делают — операции остаются без
# категории, а выписка неизвестного формата уходит в ручной разбор.
# Эндпоинт любой OpenAI-совместимый: облако, OpenRouter, локальная Ollama.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_CATEGORIZE=gpt-4o-mini
LLM_MODEL_PARSE=gpt-4o-mini
